# Optional: the address players' phones can reach, without a trailing slash.
# Open http://YOUR-WIFI-IP:8181 on the host computer and phones on the same network.
# For an Internet deployment, use your public HTTPS URL instead.
DARKHOLD_PUBLIC_BASE_URL=

# Required: PostgreSQL password (no default). For an existing postgres_data volume use its current password.
POSTGRES_PASSWORD=

# Optional: password for admin@admin.com on first start (a random one is logged once if empty).
DARKHOLD_ADMIN_PASSWORD=

# Optional: single sign-on through one OpenID Connect provider. Enabled when issuer URI and client id are set;
# the app then contacts the issuer at startup and will not start if it is unreachable.
# Register this callback URL with the provider: {BASE_URL}/login/oauth2/code/oidc
# ({BASE_URL} is the address users open the app on, e.g. https://quiz.example.com).
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE).
OIDC_CLIENT_SECRET=
# Button label: "Continue with <name>" (default: SSO).
OIDC_PROVIDER_NAME=
