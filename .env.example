# Optional: the address players' phones can reach, without a trailing slash.
# Open http://YOUR-WIFI-IP:8181 on the host computer and phones on the same network.
# For an Internet deployment, use your public HTTPS URL instead.
DARKHOLD_PUBLIC_BASE_URL=

# Required: PostgreSQL password (no default). For an existing postgres_data volume use its current password.
POSTGRES_PASSWORD=

# Optional: password for admin@admin.com on first start (a random one is logged once if empty).
DARKHOLD_ADMIN_PASSWORD=
